arter' ? 'Project-Charter' : 'PRD'}.pdf`\n\n  const uri = await vscode.window.showSaveDialog({\n    defaultUri: vscode.Uri.file(defaultName),\n    filters: { 'PDF Files': ['pdf'] },\n  })\n\n  if (!uri) return null\n\n  try {\n    await vscode.workspace.fs.writeFile(uri, new Uint8Array(buffer))\n    return uri.fsPath\n  } catch (err) {\n    vscode.window.showErrorMessage(`Failed to write PDF: ${err}`)\n    return null\n  }\n}"}],"edges":[{"source":"pdfexporthandler","target":"vscode","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/extension/pdfExportHandler.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/extension/pdfExportHandler.ts","source_location":"L1"}],"weight":1},{"source":"pdfexporthandler","target":"path","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/extension/pdfExportHandler.ts","source_location":"L2","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/extension/pdfExportHandler.ts","source_location":"L2"}],"weight":1},{"source":"pdfexporthandler","target":"formstatemanager","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/extension/pdfExportHandler.ts","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/extension/pdfExportHandler.ts","source_location":"L3"}],"weight":1},{"source":"pdfexporthandler","target":"pdfexporthandler_handlepdfexport","relation":"contains","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/extension/pdfExportHandler.ts","source_location":"L5","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/extension/pdfExportHandl