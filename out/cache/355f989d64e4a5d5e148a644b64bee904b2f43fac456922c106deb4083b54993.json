jects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L18-L23","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L18"}],"snippet":"export interface SectionValidation {\n  complete: boolean\n  total: number\n  filled: number\n  missing: string[]\n}"},{"id":"validation_validatesection1","label":"validateSection1()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L25-L40","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L25"}],"snippet":"export function validateSection1(data: FormData): SectionValidation {\n  const missing: string[] = []\n  const s = data.section1\n\n  if (!isFilled(s.projectName)) missing.push('Project Name')\n  if (!isFilled(s.dateSubmitted)) missing.push('Date Submitted')\n  if (!isFilled(s.submittedBy)) missing.push('Submitted By')\n  if (!s.projectType) missing.push('Project Type')\n  if (!s.priority) missing.push('Priority Classification')\n  if (!isFilled(s.priorityJustification)) missing.push('Priority Justification')\n  if (!isFilled(s.budgetEstimate)) missing.push('Budget Estimate')\n  if (!isFilled(s.sponsorDecisionMaker)) missing.push('Sponsor / Decision Maker')\n\n  const total = 8\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"validation_validatesection2","label":"validateSection2()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L42-L54","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L42"}],"snippet":"export function validateSection2(data: FormData): SectionValidation {\n  const missing: string[] = []\n  const s = data.section2\n\n  if (!isFilled(s.coreProblem)) missing.push('Core Problem')\n  if (!isFilled(s.whoAffected)) missing.push('Who is Affected')\n  if (!isFilled(s.costOfInaction)) missing.push('Cost of Inaction')\n  if (!isFilled(s.primaryObjective)) missing.push('Primary Business Objective')\n  if (!isFilled(s.nonGoals)) missing.push('Non-Goals')\n\n  const total = 5\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"validation_validatesection3","label":"validateSection3()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L56-L71","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L56"}],"snippet":"export function validateSection3(data: FormData): SectionValidation {\n  const missing: string[] = []\n  const s = data.section3\n\n  if (!isFilled(s.primaryKpi)) missing.push('Primary KPI')\n  if (!isFilled(s.targetValue)) missing.push('Target Value')\n  if (!isFilled(s.measurementMethod)) missing.push('Measurement Method')\n  if (!isFilled(s.acceptanceCriterion1)) missing.push('Acceptance Criterion 1')\n\n  if (!hasCompleteTableRow(s.performanceMetrics, ['metric', 'minimumThreshold', 'target'])) {\n    missing.push('At least one complete performance metrics row (metric, minimum, and target)')\n  }\n\n  const total = 5\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"validation_validatesection4","label":"validateSection4()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L73-L91","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L73"}],"snippet":"export function validateSection4(data: FormData): SectionValidation {\n  const missing: string[] = []\n  const s = data.section4\n\n  if (\n    !hasCompleteTableRow(s.stakeholders, ['nameRole', 'interestLevel', 'influence'])\n  ) {\n    missing.push('At least one complete stakeholder row (name, interest, and influence)')\n  }\n\n  if (!isFilled(s.elicitationSummary)) missing.push('Elicitation Session Summary')\n\n  if (!hasCompleteTableRow(s.assumptions, ['assumption', 'classification'])) {\n    missing.push('At least one complete assumption row (assumption and classification)')\n  }\n\n  const total = 3\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"validation_validatesection5","label":"validateSection5()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L93-L110","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L93"}],"snippet":"export function validateSection5(data: FormData): SectionValidation {\n  const missing: string[] = []\n  const s = data.section5\n  const requiresAi = data.section1.includesAiWork\n\n  if (!isFilled(s.dataRequired)) missing.push('Data Required')\n  if (!isFilled(s.dataOwnerAccess)) missing.push('Data Owner & Access')\n  if (!isFilled(s.dataCurrentState)) missing.push('Current State of Data')\n  if (!isFilled(s.dataSensitivity)) missing.push('Data Sensitivity & Compliance')\n  if (requiresAi && !Object.values(s.aiWorkTypes).some(Boolean)) missing.push('AI Work Type')\n  if (!isFilled(s.deploymentTarget)) missing.push('Deployment Target')\n  if (!isFilled(s.acceptableErrorRate)) missing.push('Acceptable Error Rate')\n  if (!isFilled(s.whenModelWrong)) missing.push('When Model is Wrong')\n  if (!isFilled(s.whenUnavailable)) missing.push('When System is Unavailable')\n\n  const total = requiresAi ? 9 : 8\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"validation_validatesection6","label":"validateSection6()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L112-L135","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L112"}],"snippet":"export function validateSection6(data: FormData): SectionValidation {\n  const missing: string[] = []\n  const type = data.section1.projectType\n\n  if (type === 'client-services') {\n    const s = data.section6A\n    if (!isFilled(s.clientName)) missing.push('Client Name')\n    if (!isFilled(s.clientPoc)) missing.push('Client POC')\n    if (!isFilled(s.contractScope)) missing.push('Contract Scope')\n    if (!isFilled(s.deliverableFormat)) missing.push('Deliverable Format')\n    if (!isFilled(s.clientApprover)) missing.push('Client Approver')\n  } else if (type === 'internal-product') {\n    const s = data.section6B\n    if (!isFilled(s.productArea)) missing.push('Product Area')\n    if (!s.roadmapStatus) missing.push('Roadmap Status')\n    if (!isFilled(s.internalStakeholder)) missing.push('Internal Stakeholder')\n    if (!s.appetite) missing.push('Appetite')\n  } else {\n    missing.push('Project Type (Section 1)')\n  }\n\n  const total = type === 'client-services' ? 5 : 4\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"validation_validatesection7","label":"validateSection7()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L137-L154","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L137"}],"snippet":"export function validateSection7(data: FormData): SectionValidation {\n  const missing: string[] = []\n  const s = data.section7\n\n  if (!isFilled(s.timeConstraints)) missing.push('Time Constraints')\n  if (!isFilled(s.resourceConstraints)) missing.push('Resource Constraints')\n\n  if (!hasCompleteTableRow(s.risks, ['risk', 'likelihood', 'impact', 'mitigation'])) {\n    missing.push('At least one complete risk row (risk, likelihood, impact, and mitigation)')\n  }\n\n  if (!hasCompleteTableRow(s.openQuestions, ['question', 'owner', 'dueDate'])) {\n    missing.push('At least one complete open question row (question, owner, and due date)')\n  }\n\n  const total = 4\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"validation_validatesection8","label":"validateSection8()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L156-L178","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L156"}],"snippet":"export function validateSection8(data: FormData): SectionValidation {\n  const missing: string[] = []\n  const s = data.section8\n\n  const allChecked = (record: Record<string, boolean>, label: string) => {\n    const values = Object.values(record)\n    if (values.length === 0 || !values.every(Boolean)) {\n      missing.push(label)\n    }\n  }\n\n  allChecked(s.definitionOfReady, 'All Definition of Ready items')\n\n  if (!s.gateDecision) missing.push('Gate Decision')\n\n  const hasSignatures = s.signatures.filter(\n    (sig) => isFilled(sig.name) && isFilled(sig.role) && isFilled(sig.date),\n  ).length >= 2\n  if (!hasSignatures) missing.push('Both signatures required')\n\n  const total = 3\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"validation_validatesection8_allchecked","label":"allChecked()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L160-L165","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L160"}],"snippet":"allChecked = (record: Record<string, boolean>, label: string) => {\n    const values = Object.values(record)\n    if (values.length === 0 || !values.every(Boolean)) {\n      missing.push(label)\n    }\n  }"},{"id":"validation_validatesections1to7","label":"validateSections1to7()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L180-L190","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L180"}],"snippet":"export function validateSections1to7(data: FormData): boolean {\n  return [\n    validateSection1,\n    validateSection2,\n    validateSection3,\n    validateSection4,\n    validateSection5,\n    validateSection6,\n    validateSection7,\n  ].every((fn) => fn(data).complete)\n}"},{"id":"validation_isgatereviewcomplete","label":"isGateReviewComplete()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L194-L196","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L194"}],"snippet":"export function isGateReviewComplete(data: FormData): boolean {\n  return validateSection8(data).complete\n}"},{"id":"validation_isgateapproved","label":"isGateApproved()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L198-L200","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L198"}],"snippet":"export function isGateApproved(data: FormData): boolean {\n  return data.section8.gateDecision === 'approved' && isGateReviewComplete(data)\n}"},{"id":"validation_isprojectchartercomplete","label":"isProjectCharterComplete()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L202-L204","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L202"}],"snippet":"export function isProjectCharterComplete(data: FormData): boolean {\n  return isGateApproved(data)\n}"},{"id":"validation_getgatestatus","label":"getGateStatus()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L206-L212","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L206"}],"snippet":"export function getGateStatus(data: FormData): GateStatus {\n  if (!validateSections1to7(data)) return 'draft'\n  if (isGateApproved(data)) return 'approved'\n  if (data.section8.gateDecision === 'needs-revision') return 'needs-revision'\n  if (data.section8.gateDecision === 'rejected') return 'rejected'\n  return 'open'\n}"},{"id":"validation_isphaseunlocked","label":"isPhaseUnlocked()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L214-L218","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L214"}],"snippet":"export function isPhaseUnlocked(phaseId: string, _data: FormData | null): boolean {\n  if (phaseId === 'project-charter') return true\n  if (phaseId === 'prd') return true // TEMP: unlocked for testing\n  return false\n}"},{"id":"validation_getincompletesections1to7","label":"getIncompleteSections1to7()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L220-L243","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L220"}],"snippet":"export function getIncompleteSections1to7(data: FormData): { id: number; title: string; missing: string[] }[] {\n  const validators = [\n    validateSection1,\n    validateSection2,\n    validateSection3,\n    validateSection4,\n    validateSection5,\n    validateSection6,\n    validateSection7,\n  ]\n\n  const incomplete: { id: number; title: string; missing: string[] }[] = []\n  validators.forEach((fn, i) => {\n    const result = fn(data)\n    if (!result.complete) {\n      incomplete.push({\n        id: i + 1,\n        title: SECTION_LABELS[i].title,\n        missing: result.missing,\n      })\n    }\n  })\n  return incomplete\n}"},{"id":"validation_getsectionvalidator","label":"getSectionValidator()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L245-L257","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L245"}],"snippet":"export function getSectionValidator(sectionId: number) {\n  const validators = [\n    validateSection1,\n    validateSection2,\n    validateSection3,\n    validateSection4,\n    validateSection5,\n    validateSection6,\n    validateSection7,\n    validateSection8,\n  ]\n  return validators[sectionId - 1]\n}"},{"id":"validation_getoverallprogress","label":"getOverallProgress()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L259-L283","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L259"}],"snippet":"export function getOverallProgress(data: FormData): { filled: number; total: number; percent: number } {\n  const validators = [\n    validateSection1,\n    validateSection2,\n    validateSection3,\n    validateSection4,\n    validateSection5,\n    validateSection6,\n    validateSection7,\n  ]\n\n  let filled = 0\n  let total = 0\n  for (const v of validators) {\n    const result = v(data)\n    filled += result.filled\n    total += result.total\n  }\n\n  return {\n    filled,\n    total,\n    percent: total === 0 ? 0 : Math.round((filled / total) * 100),\n  }\n}"},{"id":"validation_hastablecontent","label":"hasTableContent()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L285-L287","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L285"}],"snippet":"export function hasTableContent(values: string[]): boolean {\n  return hasTableRow(values)\n}"}],"edges":[{"source":"validation","target":"form","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L1"}],"weight":1},{"source":"validation","target":"formdefaults","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L2","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L2"}],"weight":1},{"source":"validation","target":"validation_isfilled","relation":"contains","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/src/utils/validation.ts","source_location":"L4","layer"