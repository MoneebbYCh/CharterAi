imeout(timer)\n  }, [data, isDirty])\n\n  const update = useCallback((updater: (prev: FormData) => FormData) => {\n    setData((prev) => updater(prev))\n    setIsDirty(true)\n  }, [])\n\n  const reset = useCallback(() => {"},{"id":"useformstate_useformstate_handler","label":"handler()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/hooks/useFormState.ts","source_location":"L67-L72","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/hooks/useFormState.ts","source_location":"L67"}],"snippet":"handler = (event: MessageEvent) => {\n      const msg = event.data\n      if (msg.type === 'loadCharter' && msg.data) {\n        setData((prev) => ({ ...prev, ...msg.data }))\n      }\n    }"}],"edges":[{"source":"useformstate","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/src/hooks/useFormState.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/hooks/useFormState.ts","source_location":"L1"}],"weight":1},{"source":"useformstate","target":"formdefaults","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/src/hooks/useFormState.ts","source_location":"L2","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/hooks/useFormState.ts","source_location":"L2"}],"weight":1},{"source":"useformstate","target":"form","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/src/hooks/useFormState.ts","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/hooks/useFormState.ts","source_location":"L3"}],"weight":1},{"source":"useformstate","target":"vscodeapi","relati