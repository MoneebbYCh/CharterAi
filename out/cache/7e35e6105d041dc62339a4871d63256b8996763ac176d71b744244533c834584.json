owerCase()\n\n  return (\n    <div className={fieldClass(invalid)}>\n      <label htmlFor={id}>\n        {label}\n        {required && <span className=\"required-mark\"> *</span>}\n      </label>\n      <select\n        id={id}\n        value={value}\n        onChange={(e) => onChange(e.target.value)}\n        aria-invalid={invalid}\n        className={invalid ? 'input-invalid' : undefined}\n      >\n        <option value=\"\">Select…</option>\n        {options.map((opt) => (\n          <option key={opt.value} value={opt.value}>\n            {opt.label}\n          </option>\n        ))}\n      </select>","node_kind":"component"},{"id":"formfields_gatechecklistprops","label":"GateChecklistProps","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/components/FormFields.tsx","source_location":"L347-L354","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/components/FormFields.tsx","source_location":"L347"}],"snippet":"interface GateChecklistProps {\n  title: string\n  items: readonly { id: string; label: string }[]\n  values: Record<string, boolean>\n  onChange: (id: string, checked: boolean) => void\n  disabled?: boolean\n  required?: boolean\n}"},{"id":"formfields_gatechecklist","label":"GateChecklist()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/components/FormFields.tsx","source_location":"L356-L384","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/components/FormFields.tsx","source_location":"L356"}],"snippet":"export function GateChecklist({ title, items, values, onChange, disabled, required = true }: GateChecklistProps) {\n  const showValidation = useShowValidation()\n  const allChecked = items.every((item) => values[item.id])\n  const groupInvalid = Boolean(required && showValidation && !allChecked)\n\n  return (\n    <div className={`gate-checklist ${groupInv