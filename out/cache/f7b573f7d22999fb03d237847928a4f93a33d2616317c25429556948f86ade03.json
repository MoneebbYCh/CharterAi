{"__madarTsExtractorVersion":65,"nodes":[{"id":"prdvalidation","label":"prdValidation.ts","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L1"}]},{"id":"prdvalidation_isfilled","label":"isFilled()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L6-L8","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L6"}],"snippet":"function isFilled(value: string): boolean {\n  return value.trim().length > 0\n}"},{"id":"prdvalidation_hascompletetablerow","label":"hasCompleteTableRow()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L10-L14","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L10"}],"snippet":"function hasCompleteTableRow<T extends object>(rows: T[], requiredKeys: (keyof T)[]): boolean {\n  return rows.some((row) =>\n    requiredKeys.every((key) => isFilled(String((row as Record<string, string>)[key as string] ?? ''))),\n  )\n}"},{"id":"prdvalidation_validateprdsection1","label":"validatePrdSection1()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L16-L24","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L16"}],"snippet":"export function validatePrdSection1(data: PrdFormData): PrdSectionValidation {\n  const missing: string[] = []\n  const s = data.section1\n  if (!isFilled(s.solutionOverview)) missing.push('Solution Overview')\n  if (!hasCompleteTableRow(s.scopeItems, ['item', 'description'])) missing.push('At least one scope item')\n  if (!hasCompleteTableRow(s.keyDecisions, ['decision', 'rationale'])) missing.push('At least one key decision')\n  const total = 3\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"prdvalidation_validateprdsection2","label":"validatePrdSection2()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L26-L34","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L26"}],"snippet":"export function validatePrdSection2(data: PrdFormData): PrdSectionValidation {\n  const missing: string[] = []\n  const s = data.section2\n  if (!hasCompleteTableRow(s.businessGoals, ['goal', 'owner'])) missing.push('At least one business goal')\n  if (!hasCompleteTableRow(s.successMetrics, ['metric', 'target'])) missing.push('At least one success metric')\n  if (!hasCompleteTableRow(s.outOfScope, ['item'])) missing.push('At least one out-of-scope item')\n  const total = 3\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"prdvalidation_validateprdsection3","label":"validatePrdSection3()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L36-L44","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L36"}],"snippet":"export function validatePrdSection3(data: PrdFormData): PrdSectionValidation {\n  const missing: string[] = []\n  const s = data.section3\n  if (!hasCompleteTableRow(s.personas, ['persona', 'description'])) {\n    missing.push('At least one complete persona row (name and description)')\n  }\n  const total = 1\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"prdvalidation_validateprdsection4","label":"validatePrdSection4()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L46-L54","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L46"}],"snippet":"export function validatePrdSection4(data: PrdFormData): PrdSectionValidation {\n  const missing: string[] = []\n  const s = data.section4\n  if (!hasCompleteTableRow(s.features, ['epic', 'userStory'])) {\n    missing.push('At least one complete feature row (epic and user story)')\n  }\n  const total = 1\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"prdvalidation_validateprdsection5","label":"validatePrdSection5()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L56-L63","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L56"}],"snippet":"export function validatePrdSection5(data: PrdFormData): PrdSectionValidation {\n  const missing: string[] = []\n  const s = data.section5\n  if (!hasCompleteTableRow(s.performanceRequirements, ['requirement'])) missing.push('At least one performance requirement')\n  if (!hasCompleteTableRow(s.securityRequirements, ['requirement'])) missing.push('At least one security requirement')\n  const total = 2\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"prdvalidation_validateprdsection6","label":"validatePrdSection6()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L65-L79","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L65"}],"snippet":"export function validatePrdSection6(data: PrdFormData, charterData: FormData | null): PrdSectionValidation {\n  const missing: string[] = []\n  const s = data.section6\n  const requiresAi = charterData?.section1.includesAiWork ?? true\n\n  if (!hasCompleteTableRow(s.dataSources, ['source', 'type'])) missing.push('At least one data source')\n  if (!hasCompleteTableRow(s.dataAccessRequirements, ['role', 'accessLevel'])) missing.push('At least one data access row')\n\n  if (requiresAi && !isFilled(s.aiModelSelectionCriteria)) missing.push('AI Model Selection Criteria')\n  if (requiresAi && !isFilled(s.aiEvalCriteria)) missing.push('AI Evaluation Criteria')\n\n  const aiCount = requiresAi ? 2 : 0\n  const total = 2 + aiCount\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"prdvalidation_validateprdsection7","label":"validatePrdSection7()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L81-L91","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L81"}],"snippet":"export function validatePrdSection7(data: PrdFormData): PrdSectionValidation {\n  const missing: string[] = []\n  const s = data.section7\n  if (!isFilled(s.releaseStrategy)) missing.push('Release Strategy')\n  if (!hasCompleteTableRow(s.keyMilestones, ['milestone', 'date'])) missing.push('At least one key milestone')\n  if (!hasCompleteTableRow(s.risks, ['risk', 'likelihood', 'impact'])) {\n    missing.push('At least one complete risk row')\n  }\n  const total = 3\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"prdvalidation_validateprdsection8","label":"validatePrdSection8()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L93-L103","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L93"}],"snippet":"export function validatePrdSection8(data: PrdFormData): PrdSectionValidation {\n  const missing: string[] = []\n  const s = data.section8\n  if (!s.prdStatus) missing.push('PRD Status')\n  const hasSignatures = s.signatures.filter(\n    (sig) => isFilled(sig.name) && isFilled(sig.role) && isFilled(sig.date),\n  ).length >= 2\n  if (!hasSignatures) missing.push('Both signatures required')\n  const total = 2\n  return { complete: missing.length === 0, total, filled: total - missing.length, missing }\n}"},{"id":"prdvalidation_validateprdsections1to7","label":"validatePrdSections1to7()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L105-L115","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L105"}],"snippet":"export function validatePrdSections1to7(prdData: PrdFormData, charterData: FormData | null): boolean {\n  return [\n    validatePrdSection1,\n    validatePrdSection2,\n    validatePrdSection3,\n    validatePrdSection4,\n    validatePrdSection5,\n    (d: PrdFormData) => validatePrdSection6(d, charterData),\n    validatePrdSection7,\n  ].every((fn) => fn(prdData).complete)\n}"},{"id":"prdvalidation_getprdsectionvalidator","label":"getPrdSectionValidator()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L117-L129","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L117"}],"snippet":"export function getPrdSectionValidator(sectionId: number, charterData: FormData | null) {\n  const validators: ((data: PrdFormData) => PrdSectionValidation)[] = [\n    validatePrdSection1,\n    validatePrdSection2,\n    validatePrdSection3,\n    validatePrdSection4,\n    validatePrdSection5,\n    (data) => validatePrdSection6(data, charterData),\n    validatePrdSection7,\n    validatePrdSection8,\n  ]\n  return validators[sectionId - 1]\n}"},{"id":"prdvalidation_getprdoverallprogress","label":"getPrdOverallProgress()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L131-L153","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L131"}],"snippet":"export function getPrdOverallProgress(prdData: PrdFormData, charterData: FormData | null): { filled: number; total: number; percent: number } {\n  const validators = [\n    validatePrdSection1,\n    validatePrdSection2,\n    validatePrdSection3,\n    validatePrdSection4,\n    validatePrdSection5,\n    (data: PrdFormData) => validatePrdSection6(data, charterData),\n    validatePrdSection7,\n  ]\n  let filled = 0\n  let total = 0\n  for (const v of validators) {\n    const result = v(prdData)\n    filled += result.filled\n    total += result.total\n  }\n  return {\n    filled,\n    total,\n    percent: total === 0 ? 0 : Math.round((filled / total) * 100),\n  }\n}"},{"id":"prdvalidation_getprdincompletesections1to7","label":"getPrdIncompleteSections1to7()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L155-L177","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L155"}],"snippet":"export function getPrdIncompleteSections1to7(prdData: PrdFormData, charterData: FormData | null): { id: number; title: string; missing: string[] }[] {\n  const validators = [\n    validatePrdSection1,\n    validatePrdSection2,\n    validatePrdSection3,\n    validatePrdSection4,\n    validatePrdSection5,\n    (data: PrdFormData) => validatePrdSection6(data, charterData),\n    validatePrdSection7,\n  ]\n  const incomplete: { id: number; title: string; missing: string[] }[] = []\n  validators.forEach((fn, i) => {\n    const result = fn(prdData)\n    if (!result.complete) {\n      incomplete.push({\n        id: i + 1,\n        title: PRD_SECTION_LABELS[i].title,\n        missing: result.missing,\n      })\n    }\n  })\n  return incomplete\n}"},{"id":"prdvalidation_getprdgatestatus","label":"getPrdGateStatus()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L179-L181","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L179"}],"snippet":"export function getPrdGateStatus(data: PrdFormData): PrdFormData['section8']['prdStatus'] {\n  return data.section8.prdStatus || 'draft'\n}"},{"id":"prdvalidation_isprdapproved","label":"isPrdApproved()","file_type":"code","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L183-L185","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L183"}],"snippet":"export function isPrdApproved(data: PrdFormData): boolean {\n  return data.section8.prdStatus === 'approved' && validatePrdSection8(data).complete\n}"}],"edges":[{"source":"prdvalidation","target":"form","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Projects/Req-Gath-Sys/src/utils/prdValidation.ts","source_location":"L1","layer"